local function CopiarAlPortapapeles(link)
    if setclipboard then
        setclipboard(link)
        StatusLabel.Text = "¡Enlace copiado al portapapeles!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
    else
        StatusLabel.Text = "Tu ejecutor no soporta copiar directo"
        print("Link para la key: " .. link)
    end
end

local function ValidarEnServidor(proveedor, key)
    local endpoint = BACKEND_URL .. "/api/verify-" .. proveedor
    local payload = HttpService:JSONEncode({
        key = key,
        user_id = tostring(LocalPlayer.UserId)
    })
    
    local success, response = pcall(function()
        return request({
            Url = endpoint,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = payload
        })
    end)
    
    if success and response.StatusCode == 200 then
        local data = HttpService:JSONDecode(response.Body)
        return data.valid == true
    end
    return false
end

local function CargarScriptPrincipal()
    local success, err = pcall(function()
        loadstring(game:HttpGet(SCRIPT_URL))()
    end)
    if not success then
        warn("Error al cargar el script principal:", err)
    end
end

