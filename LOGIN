local function CopiarAlPortapapeles(link)
    if setclipboard then
        setclipboard(link)
        StatusLabel.Text = "¡Link copiado al portapapeles!"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
    else
        StatusLabel.Text = "Copia el link enviado a la consola"
        print("Link de Key Platoboost: " .. link)
    end
end

-- Botón Obtener Key (Consigue el enlace de Platoboost mediante consulta HTTP a auth.platorelay.com)
local BtnGetPlato = Instance.new("TextButton")
BtnGetPlato.Size = UDim2.new(0.9, 0, 0, 32)
BtnGetPlato.Position = UDim2.new(0.05, 0, 0.52, 0)
BtnGetPlato.BackgroundColor3 = Color3.fromRGB(150, 0, 150)
BtnGetPlato.Text = "Obtener Key (Platoboost)"
BtnGetPlato.TextColor3 = Color3.fromRGB(255, 255, 255)
BtnGetPlato.TextSize = 13
BtnGetPlato.Parent = Frame

BtnGetPlato.MouseButton1Click:Connect(function()
    StatusLabel.Text = "Generando link de Platoboost..."
    
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    local url = "https://auth.platorelay.com/public/whitelist/" .. PLATOBOOST_ID .. "?id=" .. tostring(LocalPlayer.UserId)
    
    if req then
        local success, response = pcall(function()
            return req({
                Url = url,
                Method = "GET"
            })
        end)
        
        if success and response then
            CopiarAlPortapapeles(url)
        else
            CopiarAlPortapapeles(url)
        end
    else
        CopiarAlPortapapeles(url)
    end
end)

-- Botón Verificar Key (Valida la Key enviando la consulta directa a auth.platorelay.com)
local BtnVerify = Instance.new("TextButton")
BtnVerify.Size = UDim2.new(0.9, 0, 0, 35)
BtnVerify.Position = UDim2.new(0.05, 0, 0.72, 0)
BtnVerify.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
BtnVerify.Text = "Verificar Key"
BtnVerify.TextColor3 = Color3.fromRGB(255, 255, 255)
BtnVerify.TextSize = 13
BtnVerify.Parent = Frame

BtnVerify.MouseButton1Click:Connect(function()
    local userKey = TextBox.Text
    if userKey == "" then
        StatusLabel.Text = "Por favor ingresa una key"
        return
    end
    
    StatusLabel.Text = "Verificando con Platoboost..."
    
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    local verifyUrl = "https://auth.platorelay.com/public/whitelist/check/" .. PLATOBOOST_ID .. "?id=" .. tostring(LocalPlayer.UserId) .. "&key=" .. userKey
    
    if req then
        local success, response = pcall(function()
            return req({
                Url = verifyUrl,
                Method = "GET"
            })
        end)
        
        if success and response.StatusCode == 200 then
            local data = HttpService:JSONDecode(response.Body)
            if data and (data.valid == true or data.status == "success" or data.whitelisted == true) then
                StatusLabel.Text = "¡Key Válida! Cargando script..."
                StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
                task.wait(1.5)
                ScreenGui:Destroy()
                loadstring(game:HttpGet(SCRIPT_URL))()
            else
                StatusLabel.Text = "Key incorrecta o no válida"
                StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
            end
        else
            StatusLabel.Text = "Error al conectar con Platoboost"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        end
    else
        StatusLabel.Text = "Tu ejecutor no soporta peticiones HTTP"
    end
end)
